# AI Traffic Management System - configuration template
#
#   cp .env.example backend/.env    and edit
#
# Every setting has a working default; nothing here is required to run locally.
# Settings are read from TRAFFIC_-prefixed environment variables, except
# ENVIRONMENT itself, which selects the profile.

# =============================================================================
# PROFILE
# =============================================================================
# development (default) | testing | production
#   development  debug on, API docs served, permissive hosts
#   production   debug off, docs disabled, JSON logs, stricter rate limits, and
#                a startup audit that refuses wildcards and a missing API key
ENVIRONMENT=development

# =============================================================================
# HTTP SERVER
# =============================================================================
TRAFFIC_API_HOST=0.0.0.0
TRAFFIC_API_PORT=8000

# Origins allowed to call the API from a browser. Comma-separated.
# A wildcard is rejected in production.
TRAFFIC_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Host header allowlist. Set this to your real hostname in production;
# leaving it "*" is flagged by the configuration audit.
TRAFFIC_TRUSTED_HOSTS=*

# =============================================================================
# SECURITY
# =============================================================================
# Shared key required on write endpoints (X-API-Key header). Leave empty for a
# local demo; required in production.
#   generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TRAFFIC_API_KEY=

# Only needed if you issue JWTs from an external identity provider.
# Must be at least 32 characters when set.
TRAFFIC_JWT_SECRET_KEY=

TRAFFIC_RATE_LIMIT_REQUESTS_PER_MINUTE=120
TRAFFIC_RATE_LIMIT_UPLOAD_REQUESTS_PER_MINUTE=20
TRAFFIC_MAX_UPLOAD_SIZE_MB=25

# =============================================================================
# DETECTION MODEL
# =============================================================================
# yolov8n.pt  6 MB   fastest, good enough for queue counting  (default)
# yolov8s.pt  22 MB  better on small/distant vehicles
# yolov8m.pt  50 MB  more accurate, ~3x slower on CPU
# yolo11n.pt         newer architecture, same interface
TRAFFIC_MODEL_NAME=yolov8n.pt
TRAFFIC_MODEL_CACHE_DIRECTORY=./models

# Lower catches more distant vehicles but admits more false positives.
TRAFFIC_DETECTION_CONFIDENCE_THRESHOLD=0.35
TRAFFIC_NON_MAX_SUPPRESSION_THRESHOLD=0.45

# Larger sees smaller objects but costs roughly quadratic time.
TRAFFIC_DETECTION_IMAGE_SIZE=640

# Requires a CUDA build of torch. Leave false on CPU-only hosts.
TRAFFIC_ENABLE_GPU_ACCELERATION=false

# Concurrent inferences. Raise only if the host has cores or VRAM to spare.
TRAFFIC_MAX_CONCURRENT_INFERENCES=2

# Video sampling: analyse every Nth frame, up to this many frames per request.
TRAFFIC_VIDEO_FRAME_STRIDE=3
TRAFFIC_VIDEO_MAX_FRAMES=300

# =============================================================================
# SIGNAL TIMING
# =============================================================================
TRAFFIC_MINIMUM_GREEN_DURATION=10
TRAFFIC_MAXIMUM_GREEN_DURATION=120
TRAFFIC_DEFAULT_GREEN_SIGNAL_DURATION=30
TRAFFIC_YELLOW_SIGNAL_DURATION=3

# All-red clearance between conflicting phases. Do not set this to 0 on real
# hardware: it is what lets the intersection empty before the next green.
TRAFFIC_ALL_RED_CLEARANCE_DURATION=2

# Extra green granted per queued passenger-car unit. Higher is more responsive
# to demand but produces longer, less predictable cycles.
TRAFFIC_SECONDS_PER_QUEUED_VEHICLE=2.0

TRAFFIC_CONTROL_LOOP_INTERVAL_SECONDS=1.0

# =============================================================================
# PEDESTRIANS
# =============================================================================
TRAFFIC_PEDESTRIAN_CROSSING_DURATION=12

# Longest a pedestrian request may wait before it pre-empts vehicle phases.
# Lower it where footfall is high; long waits push people to cross on red.
TRAFFIC_PEDESTRIAN_MAX_WAIT_SECONDS=90

# =============================================================================
# EMERGENCY PRE-EMPTION
# =============================================================================
TRAFFIC_EMERGENCY_DETECTION_ENABLED=true
TRAFFIC_EMERGENCY_OVERRIDE_DURATION=45

# =============================================================================
# CORRIDOR COORDINATION
# =============================================================================
TRAFFIC_GREEN_WAVE_ENABLED=true
TRAFFIC_GREEN_WAVE_DESIGN_SPEED_KPH=50

# =============================================================================
# PERSISTENCE
# =============================================================================
TRAFFIC_PERSISTENCE_ENABLED=true

# SQLite needs no setup. For multiple replicas use Postgres:
#   postgresql+asyncpg://user:password@host:5432/traffic   (pip install asyncpg)
TRAFFIC_DATABASE_URL=sqlite+aiosqlite:///./data/traffic.db
TRAFFIC_RETENTION_DAYS=30

# Optional; only used for rate limiting shared across replicas.
TRAFFIC_REDIS_ENABLED=false
TRAFFIC_REDIS_CONNECTION_STRING=redis://localhost:6379/0

# =============================================================================
# FIELD HARDWARE
# =============================================================================
# Endpoint that receives signal-state changes (controller, PLC, relay board,
# or the bundled Arduino gateway). Empty disables the bridge.
TRAFFIC_HARDWARE_WEBHOOK_URL=
TRAFFIC_HARDWARE_WEBHOOK_TOKEN=
TRAFFIC_HARDWARE_WEBHOOK_TIMEOUT_SECONDS=3.0

# =============================================================================
# IMPACT MODEL
# =============================================================================
# These drive the delay/fuel/CO2 figures on the Insights screen. The defaults
# are mid-range published values -- replace them with local data before using
# the output in a business case.
TRAFFIC_IDLE_FUEL_LITRES_PER_HOUR=0.9
TRAFFIC_CO2_KG_PER_LITRE_PETROL=2.31
TRAFFIC_AVERAGE_VEHICLE_OCCUPANCY=1.4
TRAFFIC_VALUE_OF_TIME_PER_HOUR=8.0
TRAFFIC_IMPACT_CURRENCY=USD

# The fixed-time plan that adaptive control is compared against.
TRAFFIC_BASELINE_FIXED_CYCLE_SECONDS=120

# =============================================================================
# LOGGING
# =============================================================================
TRAFFIC_LOG_LEVEL=INFO
TRAFFIC_LOG_JSON=false
TRAFFIC_ENABLE_FILE_LOGGING=true
TRAFFIC_LOG_FILE_PATH=./logs/traffic_system.log

# =============================================================================
# DASHBOARD (frontend/.env - baked in at build time)
# =============================================================================
# VITE_API_URL=          empty means same-origin, which the dev proxy handles
# VITE_WS_URL=           derived from VITE_API_URL when unset
# VITE_API_KEY=          must match TRAFFIC_API_KEY when one is configured
